@model RestoranProjesi.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card bg-dark text-light border-warning shadow-lg">
            <div class="card-header border-warning text-center pb-0">
                <h3 class="text-warning"><i class="fa-solid fa-user-plus me-2"></i>Kayıt Ol</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label text-warning">Ad</label>
                            <input asp-for="FirstName" class="form-control bg-dark text-light border-warning" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label text-warning">Soyad</label>
                            <input asp-for="LastName" class="form-control bg-dark text-light border-warning" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-warning">E-posta</label>
                        <input asp-for="Email" class="form-control bg-dark text-light border-warning" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label text-warning">Telefon Numarası</label>
                        <div class="input-group">
                            <select id="countryCode" class="form-select bg-dark text-light border-warning" style="max-width: 110px;">
                                <option value="+90">🇹🇷 +90</option>
                                <option value="+1">🇺🇸 +1</option>
                                <option value="+44">🇬🇧 +44</option>
                                <option value="+49">🇩🇪 +49</option>
                                <option value="+33">🇫🇷 +33</option>
                            </select>
                            <input type="text" id="phonePart" class="form-control bg-dark text-light border-warning" placeholder="5551234567" oninput="this.value = this.value.replace(/[^0-9]/g, ''); updatePhone();" maxlength="11" />
                        </div>
                        <input type="hidden" asp-for="PhoneNumber" id="fullPhoneNumber" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-warning">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-warning text-warning"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="Password" id="regPassword" class="form-control bg-dark text-light border-warning" onkeyup="checkCapsLock(event, 'capsLockWarningReg')" />
                            <button class="btn btn-outline-warning" type="button" onclick="togglePassword('regPassword', 'eyeIconReg')">
                                <i class="fa-solid fa-eye" id="eyeIconReg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div id="capsLockWarningReg" class="small mt-1 fw-bold" style="display: none;"></div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-warning">Şifre (Tekrar)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-warning text-warning"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="ConfirmPassword" id="regConfirmPassword" class="form-control bg-dark text-light border-warning" />
                            <button class="btn btn-outline-warning" type="button" onclick="togglePassword('regConfirmPassword', 'eyeIconRegConfirm')">
                                <i class="fa-solid fa-eye" id="eyeIconRegConfirm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning fw-bold text-dark rounded-pill">Hesap Oluştur</button>
                    </div>
                    <div class="text-center">
                        <p class="mb-0 text-muted">Zaten hesabınız var mı? <a asp-action="Login" class="text-warning fw-bold text-decoration-none">Giriş Yap</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        function checkCapsLock(event, warningId) {
            var warningEl = document.getElementById(warningId);
            if (event.getModifierState && event.getModifierState('CapsLock')) {
                warningEl.style.display = 'block';
                warningEl.innerHTML = '<i class="fa-solid fa-circle-exclamation me-1"></i>Caps Lock Açık';
                warningEl.className = 'small mt-1 fw-bold text-success';
            } else {
                warningEl.style.display = 'block';
                warningEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Caps Lock Kapalı';
                warningEl.className = 'small mt-1 fw-bold text-danger';
            }
        }

        function updatePhone() {
            var code = document.getElementById("countryCode").value;
            var num = document.getElementById("phonePart").value;
            document.getElementById("fullPhoneNumber").value = code + num;
        }

        document.getElementById("countryCode").addEventListener("change", updatePhone);
        
        // Form submit before hook to ensure value is populated
        document.querySelector('form').addEventListener('submit', function() {
            updatePhone();
        });
    </script>
}
