@{
    ViewData["Title"] = "E-posta Doğrulama";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden text-center p-4">
                <i class="fa-solid fa-envelope-circle-check text-warning mb-4" style="font-size: 4rem;"></i>
                <h3 class="text-white fw-bold mb-3">E-posta Onayı</h3>
                <p class="text-light mb-4">
                    <strong>@ViewBag.NewEmail</strong> adresine gönderdiğimiz 6 haneli onay kodunu aşağıya giriniz.
                </p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-info border-info text-info mb-4" role="alert">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="VerifyEmail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-4">
                        <input type="text" name="code" class="form-control form-control-lg bg-dark text-white border-warning text-center fw-bold fs-3" placeholder="000000" maxlength="6" autocomplete="off" required style="letter-spacing: 0.5em;" />
                    </div>

                    <button type="submit" class="btn btn-warning w-100 rounded-pill py-3 fw-bold">
                        DOĞRULA
                    </button>
                    <a asp-action="Profile" class="btn btn-outline-light w-100 rounded-pill py-2 mt-3">İptal Et</a>
                </form>
            </div>
        </div>
    </div>
</div>
