@model dynamic
@{
    ViewData["Title"] = "Günlük Log";
    DateTime date = ViewBag.Date;
}

<div class="row mt-4">
    <div class="col-md-12 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-warning"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Günlük Log Kayıtları</h2>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill"><i class="fa-solid fa-arrow-left me-2"></i>Dashboard'a Dön</a>
        </div>

        <div class="card bg-dark border-warning border-opacity-25 shadow p-4 mb-4">
            <div class="row align-items-end g-3">
                <div class="col-md-5">
                    <form asp-action="DailyLog" method="get" id="dateFilterForm" class="row g-2">
                        <div class="col-8">
                            <label class="form-label text-warning small fw-bold text-uppercase">Kayıtlı Gün Seçiniz</label>
                            <select name="date" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                                <option value="">--- Gün Seçin ---</option>
                                @foreach (var record in ViewBag.RecordedDays)
                                {
                                    <option value="@record.LogDate" selected="@(Context.Request.Query["date"] == record.LogDate)">
                                        @record.LogDate
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-warning w-100 fw-bold">
                                <i class="fa-solid fa-magnifying-glass me-2"></i>Sorgula
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-outline-success w-100 fw-bold rounded-pill" data-bs-toggle="modal" data-bs-target="#newDayModal">
                        <i class="fa-solid fa-plus-circle me-2"></i>Yeni Gün Sayfası
                    </button>
                </div>
                <div class="col-md-4 text-end">
                    <div class="text-light opacity-50 small">Rapor Oluşturma Zamanı: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- Yeni Gün Modalı -->
        <div class="modal fade" id="newDayModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-warning border-opacity-50 text-white">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-warning"><i class="fa-solid fa-calendar-plus me-2"></i>Yeni Gün Kaydı Oluştur</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="CreateDailyLog" method="post">
                        <div class="modal-body py-4">
                            <label class="form-label text-light small fw-bold text-uppercase">Log Başlığı / Tarihi Giriniz</label>
                            <input type="text" name="date" class="form-control bg-dark text-white border-secondary mb-3" required placeholder="Örn: 30.04.2026 veya Açılış Günü" />
                            <p class="text-muted small">Not: Belirlediğiniz bu isimle yeni bir log sayfası açılacaktır. Eğer tarih formatında (GG.AA.YYYY) girerseniz o güne ait otomatik istatistikler de hesaplanır.</p>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-warning fw-bold px-4">Oluştur ve Git</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card bg-dark border-success border-opacity-50 shadow h-100">
                    <div class="card-body text-center py-5">
                        <i class="fa-solid fa-turkish-lira-sign text-success mb-3" style="font-size: 3rem;"></i>
                        <h5 class="text-light opacity-50 small text-uppercase fw-bold">Günlük Kazanç</h5>
                        <h2 class="text-success fw-bold mb-0">₺@Model.TotalEarnings.ToString("N2")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-8 mb-4">
                <div class="row g-4 h-100">
                    <div class="col-md-4">
                        <div class="card bg-dark border-info border-opacity-25 shadow h-100">
                            <div class="card-body text-center">
                                <div class="text-info fs-1 mb-2">@Model.TotalOrders</div>
                                <div class="text-light opacity-50 small text-uppercase fw-bold">Toplam Sipariş</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-dark border-primary border-opacity-25 shadow h-100">
                            <div class="card-body text-center">
                                <div class="text-primary fs-1 mb-2">@Model.CompletedOrders</div>
                                <div class="text-light opacity-50 small text-uppercase fw-bold">Tamamlanan</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-dark border-danger border-opacity-25 shadow h-100">
                            <div class="card-body text-center">
                                <div class="text-danger fs-1 mb-2">@Model.CancelledOrders</div>
                                <div class="text-light opacity-50 small text-uppercase fw-bold">İptal Edilen</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-dark border-secondary border-opacity-10 shadow mb-5">
            <div class="card-header bg-transparent border-secondary border-opacity-10 py-4 text-center">
                <h6 class="text-warning text-uppercase fw-bold tracking-widest mb-2">Günlük Detay Raporu</h6>
                <h2 class="m-0 text-white fw-bold"><i class="fa-solid fa-calendar-day text-warning me-3"></i>@ViewBag.LogTitle</h2>
            </div>
            <div class="card-body p-5 text-center">
                <div class="row justify-content-center">
                    <div class="col-md-10">
                        <p class="text-light fs-5 opacity-75">Seçilen tarihte toplam <strong>@Model.TotalOrders</strong> sipariş işlemi gerçekleşmiş olup, bu işlemlerden <strong>@Model.CompletedOrders</strong> adedi başarıyla tamamlanmış ve kasaya <strong>₺@Model.TotalEarnings.ToString("N2")</strong> giriş sağlanmıştır.</p>
                        <div class="mt-4">
                            <span class="badge rounded-pill bg-success bg-opacity-25 text-success border border-success px-4 py-2 me-2">Tamamlanan: @Model.CompletedOrders</span>
                            <span class="badge rounded-pill bg-danger bg-opacity-25 text-danger border border-danger px-4 py-2 me-2">İptal: @Model.CancelledOrders</span>
                            <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning border border-warning px-4 py-2">Bekliyor: @Model.PendingOrders</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="text-warning mb-0"><i class="fa-solid fa-receipt me-2"></i>Günün Tüm İşlemleri</h4>
            <div class="text-light opacity-50 small">Toplam @Model.TotalOrders İşlem Kaydı</div>
        </div>

        <div class="card bg-dark border-secondary border-opacity-10 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="bg-black bg-opacity-25 text-warning">
                        <tr>
                            <th class="ps-4 py-3">ID</th>
                            <th class="py-3">Müşteri / Email</th>
                            <th class="py-3">Yemekler</th>
                            <th class="py-3">Toplam Tutar</th>
                            <th class="py-3">Saat</th>
                            <th class="text-center py-3">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.DailyOrders != null)
                        {
                            foreach (RestoranProjesi.Models.Entities.Order order in ViewBag.DailyOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-light">
                                        #@order.Id
                                        @if(order.TableNumber != null)
                                        {
                                            <div class="badge bg-warning text-dark small mt-1">MASA @order.TableNumber</div>
                                        }
                                    </td>
                                    <td>
                                        @if(order.UserId != null)
                                        {
                                            <div class="text-white">@(order.User?.FirstName) @(order.User?.LastName)</div>
                                            <div class="text-muted small">@order.User?.Email</div>
                                        }
                                        else
                                        {
                                            <div class="text-info small fw-bold"><i class="fa-solid fa-user-secret me-1"></i>Misafir Müşteri</div>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-light fw-normal me-1 mb-1">
                                                @item.Product.Name (@item.Quantity)
                                            </span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">₺@order.TotalAmount.ToString("N2")</td>
                                    <td class="text-light opacity-75">@order.OrderDate.ToString("HH:mm")</td>
                                    <td class="text-center">
                                        @{
                                            var statusClass = order.Status switch
                                            {
                                                "Tamamlandı" => "bg-success",
                                                "İptal Edildi" => "bg-danger",
                                                "Yolda" => "bg-info",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <span class="badge @statusClass rounded-pill px-3">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        
                        @if (ViewBag.DailyOrders == null || !((List<RestoranProjesi.Models.Entities.Order>)ViewBag.DailyOrders).Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-light opacity-50">Seçilen gün için herhangi bir işlem kaydı bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
