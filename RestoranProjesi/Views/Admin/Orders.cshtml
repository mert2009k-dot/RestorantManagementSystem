@model IEnumerable<RestoranProjesi.Models.Entities.Order>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    var activeOrders = Model.Where(o => o.Status != "İptal Edildi" && o.Status != "Tamamlandı").ToList();
    var completedOrders = Model.Where(o => o.Status == "Tamamlandı").ToList();
    var cancelledOrders = Model.Where(o => o.Status == "İptal Edildi").ToList();
    var restoredOrders = Model.Where(o => o.IsRestored).ToList();
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <h2 class="text-warning mb-0"><i class="fa-solid fa-list-check me-2"></i>Sipariş Yönetimi</h2>
            <div class="d-flex align-items-center gap-3">
                <div class="input-group input-group-sm" style="width: 280px;">
                    <span class="input-group-text bg-dark border-warning text-warning"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="orderSearchInput" class="form-control bg-dark text-white border-warning" placeholder="#(Numara) ile ara..." onkeyup="filterOrders()">
                </div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 shadow-sm"><i class="fa-solid fa-arrow-left me-2"></i>Admin Paneline Dön</a>
            </div>
        </div>

        <ul class="nav nav-pills mb-3 border-bottom border-warning pb-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 text-light fw-bold" id="pills-active-tab" data-bs-toggle="pill" data-bs-target="#pills-active" type="button" role="tab" aria-controls="pills-active" aria-selected="true" style="background-color: transparent;">
                    <i class="fa-solid fa-bell-concierge me-2"></i>Aktif Siparişler (@activeOrders.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 ms-2 text-light fw-bold" id="pills-completed-tab" data-bs-toggle="pill" data-bs-target="#pills-completed" type="button" role="tab" aria-controls="pills-completed" aria-selected="false" style="background-color: transparent;">
                    <i class="fa-solid fa-box-archive me-2"></i>Tamamlanan Paketler (@completedOrders.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 ms-2 text-light fw-bold" id="pills-cancelled-tab" data-bs-toggle="pill" data-bs-target="#pills-cancelled" type="button" role="tab" aria-controls="pills-cancelled" aria-selected="false" style="background-color: transparent;">
                    <i class="fa-solid fa-ban me-2"></i>İptal Edilenler (@cancelledOrders.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 ms-2 text-light fw-bold" id="pills-restored-tab" data-bs-toggle="pill" data-bs-target="#pills-restored" type="button" role="tab" aria-controls="pills-restored" aria-selected="false" style="background-color: transparent;">
                    <i class="fa-solid fa-rotate-left me-2"></i>Geri Yüklenenler (@restoredOrders.Count)
                </button>
            </li>
        </ul>
        
        <style>
            .nav-pills .nav-link.active {
                background-color: #ffc107 !important;
                color: #000 !important;
            }
        </style>

        <div class="tab-content" id="pills-tabContent">
            <!-- AKTİF SİPARİŞLER -->
            <div class="tab-pane fade show active" id="pills-active" role="tabpanel" aria-labelledby="pills-active-tab" tabindex="0">
                <div class="card bg-dark border-warning shadow">
                    <div class="card-body p-0">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="text-warning" style="border-bottom: 2px solid var(--primary-color);">
                                <tr>
                                    <th class="ps-4">Sipariş No</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th class="text-end pe-4">İşlem (Onayla)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in activeOrders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">
                                            #@item.Id
                                            @if(item.TableNumber.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">MASA @item.TableNumber</span>
                                            }
                                        </td>
                                        <td>
                                            @if(item.UserId != null)
                                            {
                                                <span>@item.User?.FirstName @item.User?.LastName</span><br><small class="text-muted">@item.User?.Email</small>
                                            }
                                            else
                                            {
                                                <span class="text-info"><i class="fa-solid fa-user-secret me-1"></i>Misafir Müşteri</span>
                                            }
                                        </td>
                                        <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-success fw-bold">₺@item.TotalAmount</td>
                                        <td>
                                            @{
                                                var badgeColor = item.Status switch {
                                                "Bekliyor" => "bg-secondary",
                                                "Hazırlanıyor" => "bg-primary",
                                                "Yolda" => "bg-info text-dark",
                                                "Tamamlandı" => "bg-success",
                                                _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeColor px-3 py-2 rounded-pill">@item.Status</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-action="UpdateOrderStatus" method="post" class="d-flex justify-content-end align-items-center">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary w-auto me-2">
                                                    <option value="Hazırlanıyor" selected="@(item.Status == "Hazırlanıyor")">Hazırlanıyor</option>
                                                    <option value="Yolda" selected="@(item.Status == "Yolda")">Yolda</option>
                                                    <option value="Tamamlandı">Tamamlandı</option>
                                                    <option value="İptal Edildi">İptal Edildi</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold text-dark me-2">Güncelle</button>
                                                <a asp-action="PrintReceipt" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-warning rounded-pill" title="Adisyon Yazdır">
                                                    <i class="fa-solid fa-print"></i>
                                                </a>
                                            </form>
                                            
                                            <!-- Detay Butonu -->
                                            <button class="btn btn-sm btn-link text-light mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#details-@item.Id">
                                                <small>İçeriği Gör <i class="fa-solid fa-chevron-down"></i></small>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr id="details-@item.Id" class="collapse bg-black bg-opacity-25">
                                        <td colspan="6" class="p-4 border-bottom border-secondary">
                                            <h6 class="text-warning mb-3">Sipariş İçeriği:</h6>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                @foreach(var detail in item.OrderItems)
                                                {
                                                    <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between">
                                                        <span><strong class="text-warning">@detail.Quantity x</strong> @detail.Product?.Name</span>
                                                        <span>₺@(detail.Quantity * detail.UnitPrice)</span>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                
                                @if(!activeOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-light opacity-50">Henüz aktif sipariş bulunmuyor.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAMAMLANAN SİPARİŞLER -->
            <div class="tab-pane fade" id="pills-completed" role="tabpanel" aria-labelledby="pills-completed-tab" tabindex="0">
                <div class="card bg-dark border-success shadow">
                    <div class="card-body p-0">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="text-success" style="border-bottom: 2px solid #198754;">
                                <tr>
                                    <th class="ps-4">Sipariş No</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th class="text-end pe-4">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in completedOrders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-success">
                                            #@item.Id
                                            @if(item.TableNumber.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">MASA @item.TableNumber</span>
                                            }
                                        </td>
                                        <td>
                                            @if(item.UserId != null)
                                            {
                                                <span>@item.User?.FirstName @item.User?.LastName</span><br><small class="text-light opacity-50">@item.User?.Email</small>
                                            }
                                            else
                                            {
                                                <span class="text-info"><i class="fa-solid fa-user-secret me-1"></i>Misafir Müşteri</span>
                                            }
                                        </td>
                                        <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-success fw-bold">₺@item.TotalAmount</td>
                                        <td>
                                            <span class="badge bg-success px-3 py-2 rounded-pill">@item.Status</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="text-muted small me-3"><i class="fa-solid fa-check-double me-1"></i>Tamamlandı</span>
                                            
                                            <form asp-action="UpdateOrderStatus" method="post" class="d-inline me-2">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Geri Yüklendi" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill" title="Siparişi Geri Yükle"><i class="fa-solid fa-rotate-left me-1"></i>Geri Yükle</button>
                                            </form>
                                            
                                            <button class="btn btn-sm btn-link text-light" type="button" data-bs-toggle="collapse" data-bs-target="#details-completed-@item.Id">
                                                <small>İçeriği Gör <i class="fa-solid fa-chevron-down"></i></small>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr id="details-completed-@item.Id" class="collapse bg-black bg-opacity-25">
                                        <td colspan="6" class="p-4 border-bottom border-success">
                                            <h6 class="text-success mb-3">Sipariş İçeriği:</h6>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                @foreach(var detail in item.OrderItems)
                                                {
                                                    <li class="list-group-item bg-transparent text-light border-success border-opacity-25 d-flex justify-content-between">
                                                        <span><strong class="text-success">@detail.Quantity x</strong> @detail.Product?.Name</span>
                                                        <span>₺@(detail.Quantity * detail.UnitPrice)</span>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                
                                @if(!completedOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Henüz tamamlanmış paket bulunmuyor.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- İPTAL EDİLEN SİPARİŞLER -->
            <div class="tab-pane fade" id="pills-cancelled" role="tabpanel" aria-labelledby="pills-cancelled-tab" tabindex="0">
                <div class="card bg-dark border-danger shadow">
                    <div class="card-body p-0">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="text-danger" style="border-bottom: 2px solid #dc3545;">
                                <tr>
                                    <th class="ps-4">Sipariş No</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th class="text-end pe-4">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in cancelledOrders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-decoration-line-through text-light opacity-75">
                                            #@item.Id
                                            @if(item.TableNumber.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">MASA @item.TableNumber</span>
                                            }
                                        </td>
                                        <td class="text-light opacity-75">
                                            @if(item.UserId != null)
                                            {
                                                <span>@item.User?.FirstName @item.User?.LastName</span><br><small>@item.User?.Email</small>
                                            }
                                            else
                                            {
                                                <span class="text-info"><i class="fa-solid fa-user-secret me-1"></i>Misafir Müşteri</span>
                                            }
                                        </td>
                                        <td class="text-light opacity-75">@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-danger fw-bold">₺@item.TotalAmount</td>
                                        <td>
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">@item.Status</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Geri Yüklendi" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill" title="Siparişi Geri Yükle"><i class="fa-solid fa-rotate-left me-1"></i>Geri Yükle</button>
                                            </form>
                                            
                                            <button class="btn btn-sm btn-link text-light mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#details-cancelled-@item.Id">
                                                <small>İçeriği Gör <i class="fa-solid fa-chevron-down"></i></small>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr id="details-cancelled-@item.Id" class="collapse bg-black bg-opacity-25">
                                        <td colspan="6" class="p-4 border-bottom border-danger">
                                            <h6 class="text-danger mb-3">Sipariş İçeriği:</h6>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                @foreach(var detail in item.OrderItems)
                                                {
                                                    <li class="list-group-item bg-transparent text-light border-danger border-opacity-25 d-flex justify-content-between">
                                                        <span class="text-muted"><strong class="text-danger">@detail.Quantity x</strong> @detail.Product?.Name</span>
                                                        <span class="text-muted">₺@(detail.Quantity * detail.UnitPrice)</span>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                
                                @if(!cancelledOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">İptal edilmiş sipariş bulunmuyor.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- GERİ YÜKLENEN SİPARİŞLER -->
            <div class="tab-pane fade" id="pills-restored" role="tabpanel" aria-labelledby="pills-restored-tab" tabindex="0">
                <div class="card bg-dark border-info shadow">
                    <div class="card-body p-0">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="text-info" style="border-bottom: 2px solid #0dcaf0;">
                                <tr>
                                    <th class="ps-4">Sipariş No</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th class="text-end pe-4">İşlem (Onayla)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in restoredOrders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">#@item.Id</td>
                                        <td>@item.User?.FirstName @item.User?.LastName <br><small class="text-muted">@item.User?.Email</small></td>
                                        <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-success fw-bold">₺@item.TotalAmount</td>
                                        <td>
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">@item.Status</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="text-muted small me-3"><i class="fa-solid fa-info-circle me-1"></i>Aktif Siparişlerde</span>
                                            
                                            <!-- Detay Butonu -->
                                            <button class="btn btn-sm btn-link text-light" type="button" data-bs-toggle="collapse" data-bs-target="#details-restored-@item.Id">
                                                <small>İçeriği Gör <i class="fa-solid fa-chevron-down"></i></small>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr id="details-restored-@item.Id" class="collapse bg-black bg-opacity-25">
                                        <td colspan="6" class="p-4 border-bottom border-info">
                                            <h6 class="text-info mb-3">Sipariş İçeriği:</h6>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                @foreach(var detail in item.OrderItems)
                                                {
                                                    <li class="list-group-item bg-transparent text-light border-info border-opacity-25 d-flex justify-content-between">
                                                        <span><strong class="text-info">@detail.Quantity x</strong> @detail.Product?.Name</span>
                                                        <span>₺@(detail.Quantity * detail.UnitPrice)</span>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                
                                @if(!restoredOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Geri yüklenen sipariş bulunmuyor.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function filterOrders() {
            var input = document.getElementById('orderSearchInput').value.toLowerCase();
            // If they type 123, change to #123. If they type #123, keep it #123
            var searchStr = input;
            if (searchStr !== '' && !searchStr.startsWith('#')) {
                searchStr = '#' + searchStr;
            }
            
            var tables = document.querySelectorAll('.tab-content table');
            tables.forEach(table => {
                var trs = table.querySelectorAll('tbody tr');
                for (var i = 0; i < trs.length; i++) {
                    if (trs[i].classList.contains('collapse') || trs[i].classList.contains('text-center')) continue;
                    
                    var td = trs[i].getElementsByTagName("td")[0];
                    if (td) {
                        var textValue = td.textContent || td.innerText;
                        // For detail row associated with this order row
                        var detailRow = trs[i].nextElementSibling;
                        if (textValue.toLowerCase().indexOf(searchStr) > -1 || searchStr === '') {
                            trs[i].style.display = "";
                        } else {
                            trs[i].style.display = "none";
                            // Also hide the detail row if it was open
                            if (detailRow && detailRow.classList.contains('collapse')) {
                                detailRow.classList.remove('show');
                            }
                        }
                    }
                }
            });
        }
    </script>
}
