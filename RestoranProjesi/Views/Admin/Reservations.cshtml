@model IEnumerable<RestoranProjesi.Models.Entities.Reservation>
@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-warning"><i class="fa-solid fa-calendar-check me-2"></i>Rezervasyonlar</h2>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill"><i class="fa-solid fa-arrow-left me-2"></i>Admin Paneline Dön</a>
        </div>

        <div class="card bg-dark border-warning shadow">
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="text-warning" style="border-bottom: 2px solid var(--primary-color);">
                        <tr>
                            <th class="ps-4">Ad Soyad</th>
                            <th>Telefon</th>
                            <th>Tarih & Saat</th>
                            <th>Kişi Sayısı</th>
                            <th>Özel İstek / Not</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@res.Name</td>
                                <td>@res.Phone</td>
                                <td>
                                    <span class="text-info"><i class="fa-regular fa-calendar me-1"></i>@res.ReservationDate.ToString("dd MMM yyyy HH:mm")</span>
                                </td>
                                <td><span class="badge bg-secondary rounded-pill px-3">@res.PersonCount Kişi</span></td>
                                <td>
                                    @if(string.IsNullOrEmpty(res.Notes))
                                    {
                                        <span class="text-muted italic">-</span>
                                    }
                                    else
                                    {
                                        <span class="text-light" title="@res.Notes">
                                            @(res.Notes.Length > 30 ? res.Notes.Substring(0, 30) + "..." : res.Notes)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (res.Status == "Onaylandı")
                                    {
                                        <span class="badge bg-success">Onaylandı</span>
                                    }
                                    else if (res.Status == "Reddedildi")
                                    {
                                        <span class="badge bg-danger">Reddedildi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Bekliyor</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="UpdateReservationStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@res.Id" />
                                        <button type="submit" name="status" value="Onaylandı" class="btn btn-sm btn-outline-success" title="Onayla">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                        <button type="submit" name="status" value="Bekliyor" class="btn btn-sm btn-outline-warning" title="Beklet">
                                            <i class="fa-solid fa-clock"></i>
                                        </button>
                                        <button type="submit" name="status" value="Reddedildi" class="btn btn-sm btn-outline-danger" title="Reddet">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">Sistemde henüz bir rezervasyon bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
