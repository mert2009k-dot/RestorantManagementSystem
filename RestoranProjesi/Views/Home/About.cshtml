@model IEnumerable<RestoranProjesi.Models.Entities.Employee>
@{
    ViewData["Title"] = "Hakkımızda & Ekibimiz";
}

<!-- BİZ NEREDEYİZ & EKİBİMİZ ÜST KISMA TAŞINDI -->
<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold text-warning mb-3">Harika Ekibimiz</h1>
    <p class="text-light fs-4" style="opacity: 0.9;">Size en iyi hizmeti sunmak için çalışan profesyonel kadromuz.</p>
    <div class="divider mx-auto mb-5" style="width: 80px; height: 4px; background-color: var(--primary-color); border-radius: 2px;"></div>
</div>

<div class="row text-center mb-5 pb-5 border-bottom border-secondary justify-content-center">
    @if(Model != null && Model.Any())
    {
        @foreach(var emp in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card bg-dark border-warning h-100 shadow-lg rounded-4 overflow-hidden" style="transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='none'">
                    <img src="@emp.ImageUrl" class="card-img-top" alt="@emp.FirstName" style="height: 300px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1511367461989-f85a21fda167?auto=format&fit=crop&w=400&q=80'">
                    <div class="card-body p-4 bg-gradient">
                        <h4 class="text-warning fw-bold mb-1">@emp.FirstName @emp.LastName</h4>
                        <p class="text-light fs-5 mb-0">@emp.Position</p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted fs-4 italic">Ekibimiz şu an güncelleniyor...</p>
        </div>
    }
</div>

<div class="row align-items-center mt-5 pt-4">
    <div class="col-md-6 mb-4">
        <img src="https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?auto=format&fit=crop&w=800&q=80" class="img-fluid rounded-4 shadow-lg border border-warning" alt="Hakkımızda">
    </div>
    <div class="col-md-6 px-lg-5">
        <h2 class="fw-bold text-warning mb-4 display-5">Hakkımızda</h2>
        <p class="fs-4 text-light lh-base">2010 yılından bu yana, şehrin en iyi malzemelerini ustalıkla işleyerek misafirlerimize unutulmaz deneyimler yaşatıyoruz. Amacımız sadece karın doyurmak değil, damaklarda kalıcı bir iz bırakmaktır.</p>
        <p class="fs-4 text-light lh-base mb-5">Sıcak ortamımızda ailenizle, dostlarınızla keyifli vakit geçirirken, mutfağımızdan çıkan her bir tabağın özenle hazırlandığını hissedeceksiniz.</p>
        
        <div class="row text-center mt-4 bg-dark p-4 rounded-4 border border-secondary shadow-lg">
            <div class="col-4">
                <h2 class="text-warning fw-bold mb-0">10+</h2>
                <span class="text-light fs-5">Yıllık Tecrübe</span>
            </div>
            <div class="col-4 border-start border-end border-secondary">
                <h2 class="text-warning fw-bold mb-0">50+</h2>
                <span class="text-light fs-5">Eşsiz Menü</span>
            </div>
            <div class="col-4">
                <h2 class="text-warning fw-bold mb-0">20k+</h2>
                <span class="text-light fs-5">Mutlu Müşteri</span>
            </div>
        </div>
    </div>
</div>
