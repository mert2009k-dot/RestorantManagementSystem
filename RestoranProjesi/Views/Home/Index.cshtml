@model IEnumerable<RestoranProjesi.Models.Entities.Product>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- TAM GENİŞLİKTE HERO BÖLÜMÜ -->
<div class="hero-section shadow-lg d-flex align-items-center justify-content-center text-center" 
     style="height: 100vh; background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1920&q=80') center/cover; width: 100%; border-radius: 0; margin-top: -80px;">
    <div class="container">
        <h1 class="display-1 fw-bold text-white mb-4" style="letter-spacing: 2px; text-shadow: 2px 2px 15px rgba(0,0,0,0.9);">HOŞ GELDİNİZ</h1>
        <p class="lead text-white mb-5 fs-3 px-md-5 mx-auto" style="max-width: 800px; opacity: 0.95; text-shadow: 1px 1px 8px rgba(0,0,0,0.9);">
            Akdeniz'in Eşsiz Lezzetleri, Boğaz'ın Büyüleyici Manzarası Eşliğinde Unutulmaz Bir Deneyim.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-4">
            <a href="/Menu" class="btn btn-outline-warning btn-lg px-5 py-3 fw-bold rounded-pill hover-scale" style="border-width: 2px; letter-spacing: 1px;">
                MENÜYÜ KEŞFET
            </a>
            <a href="/Reservation/Create" class="btn btn-warning btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg hover-scale" style="letter-spacing: 1px;">
                REZERVASYON YAP
            </a>
        </div>
    </div>
</div>

<div class="container mt-5 pt-5">
    <!-- ÖNE ÇIKAN LEZZETLER (DAHA GENİŞ DÜZEN) -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary pb-3">
        <div>
            <h2 class="fw-bold text-warning mb-0 fs-1">Öne Çıkan Lezzetler</h2>
            <p class="text-muted fs-5 mb-0 mt-2">Şefin özel tavsiyeleri</p>
        </div>
        <a href="/Menu" class="btn btn-outline-warning rounded-pill px-4">Tümünü Gör <i class="fa-solid fa-arrow-right ms-2"></i></a>
    </div>

    <div class="row g-4 mb-5 pb-5">
        @if(Model != null && Model.Any())
        {
            @foreach(var item in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="food-card h-100" style="position: relative;">
                        <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80'">
                        
                        <div class="food-card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold text-white mb-0 me-2">@item.Name</h4>
                                <span class="food-price">₺@item.Price</span>
                            </div>
                            <p class="text-light mb-3" style="opacity: 0.9; min-height: 48px; font-size: 1rem;">@item.Description</p>
                            
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning fw-bold d-flex align-items-center" style="font-family: 'Playfair Display', serif; font-style: italic; font-size: 0.9rem;">
                                    <i class="fa-solid fa-medal me-2"></i>Şefin Tavsiyesi
                                </div>
                                <form asp-controller="Menu" asp-action="AddToFavorites" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none hover-scale" title="Favorilere Ekle">
                                        <i class="fa-solid fa-heart fs-4"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="mb-3">
                                <div class="text-white-50 small">
                                    <i class="fa-solid fa-star text-warning me-1"></i><i class="fa-solid fa-star text-warning me-1"></i><i class="fa-solid fa-star text-warning me-1"></i><i class="fa-solid fa-star text-warning me-1"></i><i class="fa-solid fa-star text-warning"></i>
                                </div>
                            </div>

                            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-warning border-secondary">Adet</span>
                                    <input type="number" name="quantity" class="form-control bg-dark text-white border-secondary fw-bold text-center" value="1" min="1" max="20" />
                                    <button type="submit" class="btn btn-warning fw-bold px-3">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Ekle
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- NEDEN BİZ? & BİZ NEREDEYİZ (YAN YANA FARKLI TASARIM) -->
    <div class="row g-5 align-items-stretch mb-5">
        <div class="col-lg-6">
            <div class="bg-dark p-5 rounded-4 shadow-lg h-100 d-flex flex-column justify-content-center" style="border: 1px solid rgba(197, 160, 89, 0.3); position: relative; overflow: hidden;">
                <i class="fa-solid fa-quote-left text-warning opacity-25" style="font-size: 8rem; position: absolute; top: -20px; left: -10px;"></i>
                <h2 class="fw-bold text-warning mb-4 display-5" style="z-index: 1;">Neden Biz?</h2>
                <p class="fs-4 text-white lh-base" style="z-index: 1;">Sadece en taze malzemeleri kullanıyor, usta şeflerimizin dokunuşlarıyla sıradan yemekleri birer sanat eserine dönüştürüyoruz.</p>
                <div class="d-flex align-items-center mt-4" style="z-index: 1;">
                    <i class="fa-solid fa-truck-fast text-warning fs-1 me-4"></i>
                    <div>
                        <h4 class="text-white mb-1">Hızlı Teslimat</h4>
                        <p class="text-muted mb-0">Sıcak ve taze kapınızda.</p>
                    </div>
                </div>
                <div class="d-flex align-items-center mt-4" style="z-index: 1;">
                    <i class="fa-solid fa-leaf text-warning fs-1 me-4"></i>
                    <div>
                        <h4 class="text-white mb-1">%100 Doğal</h4>
                        <p class="text-muted mb-0">Katkı maddesi içermez.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="bg-dark p-5 rounded-4 shadow-lg h-100" style="border: 1px solid rgba(255,255,255,0.05);">
                <h2 class="fw-bold text-warning mb-4 display-5"><i class="fa-solid fa-location-dot me-3"></i>Biz Neredeyiz?</h2>
                <div class="rounded-4 overflow-hidden mb-4 border border-warning" style="height: 250px; background-color: #333;">
                    <img src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=800&q=80" alt="Harita" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;" />
                </div>
                <h4 class="text-white mb-2">Hanedan Merkez</h4>
                <p class="text-light fs-5 mb-1"><i class="fa-solid fa-map-pin text-warning me-2"></i> Atatürk Caddesi, Lezzet Sokak No: 1</p>
                <p class="text-light fs-5 mb-1"><i class="fa-solid fa-city text-warning me-2"></i> Kadıköy / İstanbul</p>
                <p class="text-light fs-5"><i class="fa-solid fa-phone text-warning me-2"></i> 0 (216) 123 45 67</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-scale { transition: transform 0.3s ease; }
    .hover-scale:hover { transform: scale(1.05); }
</style>
