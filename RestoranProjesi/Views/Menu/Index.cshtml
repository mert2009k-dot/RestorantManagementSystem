@model IEnumerable<RestoranProjesi.Models.Entities.Product>
@{
    ViewData["Title"] = "Menü";
    
    // Kategorileri istediğimiz sıraya göre dizelim
    var categories = Model.Select(p => p.Category?.Name ?? "Diğer").Distinct().ToList();
    
    // Tatlı ve İçecekleri sona ayırıyoruz
    var lastCategories = new[] { "İçecekler", "Tatlılar" };
    var mainCategories = categories.Where(c => !lastCategories.Any(lc => c.Contains(lc, StringComparison.OrdinalIgnoreCase))).ToList();
    var finalCategories = categories.Where(c => lastCategories.Any(lc => c.Contains(lc, StringComparison.OrdinalIgnoreCase))).ToList();
    
    var sortedCategories = mainCategories.Concat(finalCategories).ToList();
}

<style>
    :root {
        --accent-color: #ffc107;
        --accent-hover: #e0a800;
        --card-bg: rgba(20, 20, 20, 0.7);
        --glass-border: rgba(255, 255, 255, 0.08);
    }

    body {
        font-family: 'Outfit', sans-serif;
    }

    /* Menu Hero Section */
    .menu-hero {
        position: relative;
        padding: 100px 0 60px;
        text-align: center;
        background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1920&q=80') center/cover;
        border-radius: 0 0 50px 50px;
        margin-bottom: -50px;
        z-index: 1;
    }

    .menu-hero h1 {
        font-size: 4.5rem;
        font-weight: 800;
        color: var(--accent-color);
        letter-spacing: -2px;
        margin-bottom: 10px;
        text-shadow: 0 10px 20px rgba(0,0,0,0.5);
    }

    .menu-hero p {
        font-size: 1.25rem;
        color: rgba(255,255,255,0.6);
        max-width: 600px;
        margin: 0 auto;
    }

    /* Kategori Navigasyonu */
    .filter-section {
        position: sticky;
        top: 85px;
        z-index: 100;
        padding: 20px 0;
        transition: all 0.3s ease;
    }

    .filter-container {
        background: rgba(10, 10, 10, 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 15px;
        border-radius: 100px;
        border: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        max-width: fit-content;
        margin: 0 auto;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }

    .filter-pill {
        padding: 10px 25px;
        border-radius: 100px;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
        white-space: nowrap;
        font-size: 0.9rem;
    }

    .filter-pill:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .filter-pill.active {
        background: var(--accent-color);
        color: #000;
        box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3);
    }

    /* Category Block */
    .category-block {
        padding-top: 100px;
        margin-bottom: 50px;
    }

    .category-title-wrap {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 40px;
    }

    .category-title-wrap h2 {
        font-size: 2.2rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
        letter-spacing: -1px;
    }

    .title-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--accent-color), transparent);
    }

    /* Food Card Redesign */
    .food-card-premium {
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 35px;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .food-card-premium:hover {
        transform: translateY(-15px);
        border-color: rgba(255, 193, 7, 0.3);
        box-shadow: 0 30px 60px rgba(0,0,0,0.6);
    }

    .img-wrap {
        position: relative;
        height: 250px;
        overflow: hidden;
    }

    .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s ease;
    }

    .food-card-premium:hover .img-wrap img {
        transform: scale(1.15);
    }

    .price-overlay {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(10px);
        padding: 8px 18px;
        border-radius: 20px;
        border: 1px solid rgba(255, 193, 7, 0.4);
        color: var(--accent-color);
        font-weight: 800;
        font-size: 1.1rem;
        z-index: 5;
    }

    .fav-btn-overlay {
        position: absolute;
        top: 20px;
        left: 20px;
        width: 45px;
        height: 45px;
        border-radius: 20px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        transition: all 0.3s ease;
        z-index: 5;
    }

    .fav-btn-overlay:hover {
        background: #fff;
        color: #ff4757;
        transform: rotate(15deg);
    }

    .fav-btn-overlay.active {
        color: #ff4757;
    }

    .content-wrap {
        padding: 30px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .content-wrap h3 {
        font-weight: 700;
        font-size: 1.4rem;
        margin-bottom: 12px;
        color: #fff;
    }

    .content-wrap p {
        color: rgba(255,255,255,0.5);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 25px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Quantity & Order Bar */
    .order-footer {
        margin-top: auto;
    }

    .qty-selector {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        padding: 5px;
        margin-bottom: 15px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .qty-btn {
        width: 40px;
        height: 40px;
        border-radius: 15px;
        border: none;
        background: transparent;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .qty-btn:hover {
        background: rgba(255,255,255,0.1);
        color: var(--accent-color);
    }

    .qty-val {
        font-weight: 800;
        font-size: 1.1rem;
        color: #fff;
        min-width: 30px;
        text-align: center;
    }

    .btn-add-to-cart {
        width: 100%;
        padding: 16px;
        border-radius: 22px;
        border: none;
        background: var(--accent-color);
        color: #000;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.2);
    }

    .btn-add-to-cart:hover {
        background: var(--accent-hover);
        transform: scale(1.02);
        box-shadow: 0 15px 30px rgba(255, 193, 7, 0.4);
    }

    /* Animations */
    [data-category] {
        transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .fade-out {
        opacity: 0;
        transform: scale(0.95) translateY(20px);
        pointer-events: none;
    }

    .fade-in {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
</style>

<section class="menu-hero">
    <div class="container">
        <h1>MENÜMÜZ</h1>
        <p>Geleneksel tariflerin modern dokunuşlarla buluştuğu, özenle seçilmiş malzemelerle hazırlanan eşsiz lezzet yolculuğuna davetlisiniz.</p>
        
        @if (ViewBag.TableMessage != null)
        {
            <div class="mt-4">
                <span class="badge bg-warning text-dark px-4 py-2 rounded-pill fw-bold shadow-lg">
                    <i class="fa-solid fa-qrcode me-2"></i> @ViewBag.TableMessage
                </span>
            </div>
        }
    </div>
</section>

<!-- Filtre Bar -->
<div class="filter-section">
    <div class="container">
        <div class="filter-container">
            <div class="filter-pill active" data-filter="all">Tüm Lezzetler</div>
            @foreach (var catName in sortedCategories)
            {
                <div class="filter-pill" data-filter="@catName.Replace(" ", "-")">@catName</div>
            }
        </div>
    </div>
</div>

<div class="container py-5" style="margin-top: 20px;">
    <div id="menu-scroll-container">
        @foreach (var catName in sortedCategories)
        {
            var items = Model.Where(p => (p.Category?.Name ?? "Diğer") == catName).ToList();
            if (!items.Any()) continue;

            <div class="category-block" data-category="@catName.Replace(" ", "-")">
                <div class="category-title-wrap">
                    <h2>@catName</h2>
                    <div class="title-line"></div>
                </div>

                <div class="row g-5">
                    @foreach (var item in items)
                    {
                        <div class="col-sm-12 col-md-6 col-lg-4 col-xl-3">
                            <div class="food-card-premium">
                                <div class="img-wrap">
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80'">
                                    <div class="price-overlay">₺@item.Price</div>
                                    
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        var isFav = ((List<int>?)ViewBag.FavoriteIds)?.Contains(item.Id) ?? false;
                                        <button onclick="toggleFavorite(this, @item.Id)" class="fav-btn-overlay @(isFav ? "active" : "")">
                                            <i class="fa-@(isFav ? "solid" : "regular") fa-heart fs-5"></i>
                                        </button>
                                    }
                                </div>
                                
                                <div class="content-wrap">
                                    <h3>@item.Name</h3>
                                    <p>@item.Description</p>
                                    
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="order-footer">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        
                                        <div class="qty-selector">
                                            <button type="button" class="qty-btn" onclick="updateQty(this, -1)">
                                                <i class="fa-solid fa-minus"></i>
                                            </button>
                                            <div class="qty-val">1</div>
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="button" class="qty-btn" onclick="updateQty(this, 1)">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>
                                        </div>

                                        <button type="submit" class="btn-add-to-cart">
                                            <i class="fa-solid fa-cart-shopping"></i> EKLE
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtreleme mantığı
            $('.filter-pill').click(function() {
                const filter = $(this).data('filter');
                
                $('.filter-pill').removeClass('active');
                $(this).addClass('active');
                
                if (filter === 'all') {
                    $('.category-block').removeClass('fade-out').addClass('fade-in').show();
                } else {
                    $('.category-block').each(function() {
                        if ($(this).data('category') === filter) {
                            $(this).removeClass('fade-out').addClass('fade-in').show();
                        } else {
                            $(this).addClass('fade-out').hide();
                        }
                    });
                }

                // Scroll to top of categories gently
                $('html, body').animate({
                    scrollTop: $(".filter-section").offset().top - 20
                }, 500);
            });
        });

        function updateQty(btn, delta) {
            const wrapper = btn.closest('.qty-selector');
            const valDisplay = wrapper.querySelector('.qty-val');
            const input = wrapper.querySelector('input[name="quantity"]');
            
            let current = parseInt(valDisplay.textContent);
            let next = current + delta;
            
            if (next >= 1 && next <= 20) {
                valDisplay.textContent = next;
                input.value = next;
            }
        }

        function toggleFavorite(btn, productId) {
            const icon = btn.querySelector('i');
            $.post('/Menu/ToggleFavorite', { productId: productId }, function() {
                if (icon.classList.contains('fa-regular')) {
                    icon.classList.replace('fa-regular', 'fa-solid');
                    btn.classList.add('active');
                } else {
                    icon.classList.replace('fa-solid', 'fa-regular');
                    btn.classList.remove('active');
                }
            }).fail(function() {
                Swal.fire({
                    icon: 'error',
                    title: 'Hata',
                    text: 'Lütfen giriş yapın.'
                });
            });
        }
    </script>
}

