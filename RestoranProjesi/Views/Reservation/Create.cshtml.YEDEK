@model RestoranProjesi.Models.Entities.Reservation
@{
    ViewData["Title"] = "Rezervasyon Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card bg-dark text-light border-warning shadow-lg">
            <div class="card-header border-warning text-center pb-0">
                <h3 class="text-warning"><i class="fa-solid fa-calendar-check me-2"></i>Masa Rezervasyonu</h3>
                <p class="text-muted">Lütfen yerinizi ayırtmak için aşağıdaki formu doldurun.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label text-warning">Adınız Soyadınız</label>
                            <input asp-for="Name" class="form-control bg-dark text-light border-warning" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label text-warning">Telefon Numaranız</label>
                            <input asp-for="Phone" class="form-control bg-dark text-light border-warning" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReservationDate" class="form-label text-warning">Tarih ve Saat</label>
                            <input asp-for="ReservationDate" id="resDate" type="datetime-local" class="form-control bg-dark text-light border-warning" required />
                            <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PersonCount" class="form-label text-warning">Kişi Sayısı</label>
                            <input asp-for="PersonCount" type="number" min="1" max="20" class="form-control bg-dark text-light border-warning" required />
                            <span asp-validation-for="PersonCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label text-warning">Özel İstekleriniz (İsteğe Bağlı)</label>
                        <textarea asp-for="Notes" rows="3" class="form-control bg-dark text-light border-warning"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning fw-bold text-dark rounded-pill py-2 fs-5">Rezervasyonu Tamamla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('resDate').value = now.toISOString().slice(0, 16);
        });
    </script>
}
