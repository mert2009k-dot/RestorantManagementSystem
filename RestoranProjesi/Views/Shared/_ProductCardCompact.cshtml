@model RestoranProjesi.Models.Entities.Product

<div class="compact-card">
    <div class="position-relative">
        <img src="@Model.ImageUrl" class="compact-img" alt="@Model.Name" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=400&q=80'">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var isFav = ((List<int>?)ViewBag.FavoriteIds)?.Contains(Model.Id) ?? false;
            <button onclick="toggleFavorite(this, @Model.Id)" class="btn btn-link p-0 position-absolute top-0 end-0 m-2 shadow-none" style="z-index: 5;">
                <i class="fa-@(isFav ? "solid" : "regular") fa-heart text-danger fs-6"></i>
            </button>
        }
    </div>
    <div class="compact-body">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="compact-title text-truncate">@Model.Name</span>
            <span class="compact-price">@Model.Price TL</span>
        </div>
        <p class="compact-desc">@Model.Description</p>
        
        <form asp-controller="Cart" asp-action="Add" method="post" class="compact-footer">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="d-flex align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center bg-dark rounded px-2 py-1" style="border: 1px solid #333;">
                    <span class="text-warning me-2" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Adet</span>
                    <input type="number" name="quantity" class="qty-input" value="1" min="1" max="20" />
                </div>
                <button type="submit" class="btn btn-add-compact flex-grow-1">
                    <i class="fa-solid fa-plus me-1"></i> EKLE
                </button>
            </div>
        </form>
    </div>
</div>
